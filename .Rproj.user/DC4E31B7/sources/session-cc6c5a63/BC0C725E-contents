\examples{
u <- rnorm(100, 0.3, 0.8)
circplot(u)
circplot(u, labels = "radians")
circplot(u * 180 / pi, rads = FALSE, labels = "degrees")
x <- rnorm(5000, 0.3, 0.8)
circplot(x)   ## large sample, drawn as a circular histogram

## times of the day around 22:30, converted from hours to radians
h <- rnorm(100, 22.5, 1.5) \%\% 24
y <- 2 * pi * h / 24
m <- clockplot(y)
m$time
clockplot(y * 180 / pi, rads = FALSE)
}
